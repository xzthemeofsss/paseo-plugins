{
  "name": "@xzthemeofsss/paseo-link-pilot",
  "version": "0.1.0",
  "description": "Choose where chat links open for a click or Command-click in Paseo.",
  "license": "MIT",
  "author": "xzthemeofsss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzthemeofsss/paseo-plugins.git",
    "directory": "plugins/link-pilot"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "shared/",
    "assets/"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.tsx",
    "probe": "node --import tsx scripts/probe.ts",
    "lint": "oxlint client shared scripts tests index.client.tsx index.server.ts",
    "format": "oxfmt client shared scripts tests index.client.tsx index.server.ts paseo-plugin.json package.json tsconfig.json tsconfig.test.json README.md OVERVIEW.md MARKETPLACE.md assets/README.md"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "jsdom": "26.1.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
